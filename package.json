{
  "name": "humans-of-neo-ai-edit",
  "private": true,
  "version": "1.0.0",
  "description": "HyperFrames source for a vertical interview edit; media and transcripts remain local.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node setup.mjs",
    "build": "python3 build_composition.py",
    "check": "npx --yes hyperframes@0.8.174 check",
    "dev": "npx --yes hyperframes@0.8.174 preview",
    "render": "npx --yes hyperframes@0.8.174 render --output renders/humans-of-neo.mp4 --fps 30 --quality high --workers 2"
  },
  "dependencies": {
    "gsap": "3.14.2"
  }
}
